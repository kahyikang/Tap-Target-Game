<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_home_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="560dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <ImageView
            android:id="@+id/homeLogo"
            android:layout_width="116dp"
            android:layout_height="116dp"
            android:src="@drawable/tappop_four_tiles"
            android:scaleType="fitCenter"
            android:contentDescription="TapPop four-tile logo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:text="@string/tappop_name"
            android:textSize="33sp"
            android:textStyle="bold"
            android:textColor="#30264D" />

        <!-- Short TapPop tagline replaces the level-count subtitle. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:text="@string/tappop_tagline"
            android:textSize="14sp"
            android:textColor="#7858C8" />

        <LinearLayout
            android:id="@+id/playButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="38dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Play game">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@drawable/ic_play"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="PLAY GAME"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/howToPlayButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="13dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Open How to Play guide">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@drawable/ic_help"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="HOW TO PLAY"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="#30264D" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/leaderboardButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="13dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Open leaderboard">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@drawable/ic_trophy"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="LEADERBOARD"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="#30264D" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="13dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Open game settings">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@drawable/ic_settings"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="SETTINGS"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="#30264D" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
