<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingRight="16dp"
        android:paddingBottom="12dp">

        <!-- Top controls: Pause / Title / Settings. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/pauseButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:contentDescription="Pause game"
                android:src="@drawable/ic_pause"
                android:scaleType="centerInside" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="TAP THE TARGET"
                android:textColor="#0F172A"
                android:textSize="19sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:contentDescription="Game settings"
                android:src="@drawable/ic_settings"
                android:scaleType="centerInside" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Spot the different shade"
            android:textColor="#64748B"
            android:textSize="12sp" />

        <!-- Centered current-level pill. Rounded background is applied in Java. -->
        <TextView
            android:id="@+id/levelText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:paddingLeft="20dp"
            android:paddingTop="7dp"
            android:paddingRight="20dp"
            android:paddingBottom="7dp"
            android:gravity="center"
            android:text="Level 1/8"
            android:textColor="#0F172A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Large central score, without any vertical divider lines. -->
        <TextView
            android:id="@+id/scoreLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="17dp"
            android:paddingLeft="12dp"
            android:paddingTop="4dp"
            android:paddingRight="12dp"
            android:paddingBottom="4dp"
            android:gravity="center"
            android:text="TOTAL SCORE"
            android:textColor="#475569"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/scoreText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="0"
            android:textColor="#2563EB"
            android:textSize="64sp"
            android:textStyle="bold" />

        <!-- Timer and shrinking progress bar above the tiles. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TIME REMAINING"
                android:textColor="#475569"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/timerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5.0s"
                android:textColor="#0F172A"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/timerTrack"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="8dp">

            <View
                android:id="@+id/timerFill"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- Borderless, transparent board: the tiles sit on the page background. -->
        <!-- Remaining space is used to center the responsive grid. -->
        <FrameLayout
            android:id="@+id/boardContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1">

            <GridLayout
                android:id="@+id/gameGrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:alignmentMode="alignMargins"
                android:useDefaultMargins="false" />
        </FrameLayout>
    </LinearLayout>

    <!-- Translucent Level 1 countdown overlay: the 2 x 2 board stays visible beneath it. -->
    <!-- 99 is the alpha value (about 60% opaque); lower it to 66 for more visibility. -->
    <FrameLayout
        android:id="@+id/introOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99F8FAFC"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/introTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="ARE YOU READY!"
                android:textColor="#0F172A"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/introNumber"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:gravity="center"
                android:text="READY"
                android:textColor="#2563EB"
                android:textSize="66sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/introHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Find the tile with a different shade."
                android:textColor="#64748B"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
